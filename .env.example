# ==============================================================================
# UNLUPA APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env pada server baru Anda:
#   cp .env.example .env
#
# Seluruh konfigurasi di bawah dirancang agar aplikasi 100% portable
# dan dapat dipindahkan ke VPS (Ubuntu/Debian), Docker, Vercel, Railway,
# atau Google Cloud Run dengan domain kustom Anda sendiri.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Port tempat server Express berjalan (default: 3000)
PORT=3000

# URL publik atau domain kustom tempat aplikasi di-hosting (contoh: https://unlupa.id)
# Digunakan untuk tautan otentikasi, CORS, dan pemanggilan endpoint
APP_URL="https://your-custom-domain.com"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Kunci API Google Gemini untuk fitur pembuatan kitab pintar via AI & ekstraksi kartu
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
# Konfigurasi proyek Firebase untuk autentikasi dan database Firestore.
# Dapatkan dari Firebase Console: Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Opsional: Jika menggunakan database Firestore kustom (selain '(default)')
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN CONFIGURATION (BACKEND)
# ------------------------------------------------------------------------------
# ID proyek Firebase untuk inisialisasi Firebase Admin SDK di backend server.ts
FIREBASE_PROJECT_ID="your-project-id"
